# --- Server ---
PORT=4000
APP_URL=http://localhost:4000
NODE_ENV=development
# Required in production (32+ random characters)
JWT_SECRET=change-me-to-a-long-random-string-1234567890

# --- Google Calendar (leave empty to run in demo mode with built-in mock calendars) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
# 32 bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# --- AI parsing (optional; falls back to the deterministic parser when empty or on error) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Misc ---
# Serve the built frontend from the backend (set automatically if ../frontend/dist exists)
# FRONTEND_DIST=../frontend/dist
# RATE_LIMIT=off
